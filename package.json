{
  "name": "@romeohunneaul/notebook",
  "version": "0.1.0",
  "description": "Notebook: a paper-and-ink design system. Tokens, one stylesheet, React components for Next.js, Storybook.",
  "license": "MIT",
  "type": "module",
  "repository": "github:romeohunneaul/notebook",
  "files": ["src"],
  "exports": {
    ".": "./src/index.ts",
    "./reveal": "./src/components/reveal.tsx",
    "./styles.css": "./src/styles/notebook.css",
    "./tokens/*": "./src/styles/tokens/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "gsap": ">=3",
    "@gsap/react": ">=2"
  },
  "peerDependenciesMeta": {
    "gsap": { "optional": true },
    "@gsap/react": { "optional": true }
  },
  "devDependencies": {
    "@gsap/react": "^2.1.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "gsap": "^3.15.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
